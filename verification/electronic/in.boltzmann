################################################################################
# TEST: equilibrium Boltzmann distribution + energy conservation
# N2-only reservoir with every mode initialized at 20000 K. The electronic
# state populations must remain Boltzmann-distributed (detailed balance)
# and total energy (KE + eelec) must be conserved exactly.
# All states in n2boltz.elec share one spin, so all transitions are allowed.
################################################################################
seed                12345
dimension           3
global              gridcut 1.0e-5 comm/sort yes
boundary            rr rr rr
create_box          0 0.0001 0 0.0001 0 0.0001
create_grid         2 2 2
balance_grid        rcb part

species             air.species N2 elecfile n2boltz.elec
mixture             gas N2 vstream 0.0 0.0 0.0 temp 20000.0 trot 20000.0 tvib 20000.0 telec 20000.0

global              nrho 1.4141E24
global              fnum 3.5352E7

collide             vss gas air.vss relax constant
collide_modify      rotate no vibrate no electronic discrete
fix                 electronic elecmode
collide_modify      remain no

create_particles    gas n 40000 twopass

compute             temp temp
stats               500
stats_style         step cpu np nattempt ncoll c_temp
dump                1 particle all 2000 dump.boltzmann.* id type vx vy vz p_eelec p_elecstate
dump_modify         1 format float %.17e

timestep            1.00E-9
run                 2000
