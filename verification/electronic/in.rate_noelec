################################################################################
# TEST: equilibrium TCE rate vs Arrhenius, no electronic mode
# O2/N2 reservoir at fixed temperature T (all modes). A single dissociation
# reaction (O2 + N2 -> O + O + N2) is tallied with compute_chem_rates yes,
# so composition stays frozen and the tally measures the equilibrium rate
# coefficient, to be compared against the input Arrhenius rate.
# Variables (set via -var): T = temperature, PE = partial_energy yes|no
################################################################################
seed                12345
dimension           3
global              gridcut 1.0e-5 comm/sort yes
boundary            rr rr rr
create_box          0 0.0001 0 0.0001 0 0.0001
create_grid         2 2 2
balance_grid        rcb part

species             air.species N2 O2 O N
mixture             gas N2 O2 vstream 0.0 0.0 0.0 temp ${T} trot ${T} tvib ${T}
mixture             gas N2 frac 0.5
mixture             gas O2 frac 0.5

global              nrho 7.07043E22
global              fnum 1.767E6

collide             vss all air.vss relax constant
collide_modify      rotate smooth vibrate discrete
collide_modify      remain no

react               tce o2n2.tce
react_modify        partial_energy ${PE} compute_chem_rates yes

create_particles    gas n 40000 twopass

compute             temp temp
stats               1000
stats_style         step cpu np nattempt ncoll c_temp

timestep            1.00E-9
run                 2000
