################################################################################
# TEST: electronic relaxation RATE vs input collision number
# N2 two-level system, translation hot / electronic cold. The per-state
# relaxation probability PHI is baked into n2_rate.elec (generated by the
# driver from n2_rate.elec.tmpl). Run at high PHI and low PHI; the driver
# checks the high-PHI gas relaxes its electronic energy faster (higher eelec
# at a fixed early time). Pins the transient rate, not just equilibrium.
################################################################################
seed                12345
dimension           3
global              gridcut 1.0e-5 comm/sort yes
boundary            rr rr rr
create_box          0 0.0001 0 0.0001 0 0.0001
create_grid         2 2 2
balance_grid        rcb part

species             air.species N2 elecfile n2_rate.elec
mixture             gas N2 vstream 0.0 0.0 0.0 temp 30000.0 trot 100.0 tvib 100.0 telec 100.0

global              nrho 1.4141E24
global              fnum 3.5352E7

collide             vss gas air.vss relax constant
collide_modify      rotate no vibrate no electronic discrete
fix                 electronic elecmode
collide_modify      remain no

create_particles    gas n 40000 twopass
compute             eelec grid all species eelec
compute             Eelec reduce ave c_eelec[1]
compute             temp temp
stats               5
stats_style         step cpu np nattempt ncoll c_temp c_Eelec
timestep            1.00E-9
run                 300
