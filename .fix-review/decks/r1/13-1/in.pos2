include hemit
mixture air N2 O2 N vstream 10.0 0 0 temp 10.0
read_surf data.circle
surf_collide 1 diffuse 300.0 0.0
surf_modify all collide 1
variable a equal 0.5
variable b equal 0.25
variable a1 equal 0.9
group s1 surf id 1
custom surf create fr float 3 set fr[1] v_a all NULL set fr[2] v_b all NULL set fr[3] v_b all NULL
custom surf set fr[1] v_a1 s1 NULL
fix in emit/surf air all normal yes perspecies no custom fractions s_fr
timestep 0.0001
run 30
