include hemit
mixture air N2 O2 N vstream 10.0 0 0 temp 10.0
read_surf data.circle
surf_collide 1 diffuse 300.0 0.0
surf_modify all collide 1
variable a equal 0.7
variable b equal 0.2
variable c equal 0.1
custom surf create fr float 3 set fr[1] v_a all NULL set fr[2] v_b all NULL set fr[3] v_c all NULL
fix in emit/surf air all normal yes perspecies no custom fractions s_fr
timestep 0.0001
compute n count N2 O2 N
stats 10
stats_style step np c_n[*]
run 30
