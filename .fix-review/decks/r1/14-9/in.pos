seed 12345
dimension 2
global gridcut 3.0 comm/sort yes
boundary o r p
create_box 0 20 0 20 -0.5 0.5
create_grid 20 20 1
balance_grid rcb cell
global nrho 1.0 fnum 0.0001
species air.species N O
mixture air N O vstream 100.0 0 0
global surfs implicit
fix ablate ablate all 0 0.0 uniform 0
read_isurf all 20 20 1 disk.21 100.5 ablate
surf_collide 1 diffuse 300.0 0.0
surf_modify all collide 1
fix in emit/face air xlo
timestep 0.002
compute 1 isurf/grid all all n
fix 2 ave/grid all 1 1 1 c_1[1]
compute r reduce sum c_1[1] f_2
stats 10
stats_style step np c_r[1] c_r[2]
run 50
