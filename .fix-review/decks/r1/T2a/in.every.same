seed 12345
dimension 3
global gridcut 1.0e-5 comm/sort yes
boundary rr rr rr
create_box 0 0.0001 0 0.0001 0 0.0001
create_grid 4 4 4
balance_grid rcb part
species air.species N2 N O2 O NO
mixture air N2 N O2 O NO vstream 0.0 0.0 0.0 temp 20000.0
global nrho 7.07043E22 fnum 7.07043E6
collide vss air air.vss
react tce rA.tce
create_particles air n 2000 twopass
compute 1 gas/reaction/grid all air every
compute s reduce sum c_1[*]
stats 10
stats_style step np nreact c_s[*]
timestep 7.00E-9
run 20
react tce rA.tce
run 20
