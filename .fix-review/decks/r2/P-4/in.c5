# P-4: dump image with nfield 0 -> clean error, no UBSan dump_particle.cpp
seed 12345
dimension 2
global gridcut 0.0
boundary p p p
create_box 0 4 0 4 -0.5 0.5
create_grid 4 4 1
balance_grid rcb cell
species air.species N
mixture air N
global nrho 1.0 fnum 0.1
create_particles air n 100
compute 1 grid all air n
compute p ke/particle
dump 1 image all 10 i.*.ppm zoom 2
run 0
