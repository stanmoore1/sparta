# P-1 / 31-4: distributed surfs + adapt_grid coarsen + balance_grid + fix balance, compute surf (asan np2)
seed 12345
dimension 2
global gridcut 0.0 comm/sort yes surfs explicit/distributed
boundary o r p
create_box 0 10 0 10 -0.5 0.5
create_grid 10 10 1
adapt_grid all refine random 1.0 0.0 iterate 1
balance_grid rcb cell
global nrho 1.0 fnum 0.001
species air.species N O
mixture air N O vstream 100.0 0 0 temp 300
read_surf data.circle
surf_collide 1 diffuse 300.0 0.0
surf_modify all collide 1
create_particles air n 2000
adapt_grid all coarsen random 0.0 1.0 iterate 1
balance_grid rcb cell
fix in emit/face air xlo
fix bal balance 5 1.0 rcb part
compute s surf all air n press
compute r reduce sum c_s[*]
timestep 0.0001
stats 10
stats_style step np c_r[*]
run 50
