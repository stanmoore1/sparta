# P-5: UBSan memset/memcpy(NULL) on ranks w/o particles/cells (custom set_particle/set_grid)
seed 12345
dimension 2
global gridcut 0.0
boundary p p p
create_box 0 4 0 4 -0.5 0.5
create_grid 1 1 1
balance_grid rcb cell
species air.species N
mixture air N
global nrho 1.0 fnum 1.0
create_particles air n 5
variable pv particle id*0+1
variable gv grid 2.0
custom particle create pc float 0 set pc v_pv air NULL
custom grid create gc float 0 set gc v_gv all NULL
run 0
