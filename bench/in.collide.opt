# advect particles via VSS collisional flow on a uniform grid
# particles reflect off global box boundaries
#
# same physics as in.collide, plus the two performance options being studied:
#   global optmove yes            -- optimized move for uniform grid, no surfs
#   global particle/reorder N     -- reorder particles by grid cell every N steps
# reorder period is settable from the command line, e.g. -var reorder 10
# the default of 1 is the measured optimum at 1M particles; see bench/opt/ROUND9.md
# (it was 2 until the per-cell count moved into the move, which made the
#  reorder cheap enough that reordering every step wins)

variable            x index 10
variable            y index 10
variable            z index 10
variable            reorder index 1
variable            cevery index 1

variable            lx equal $x*1.0e-5
variable            ly equal $y*1.0e-5
variable            lz equal $z*1.0e-5

variable            n equal 10*$x*$y*$z

seed	    	    12345
dimension   	    3
global              gridcut 1.0e-5

boundary	    rr rr rr

create_box  	    0 ${lx} 0 ${ly} 0 ${lz}
create_grid 	    $x $y $z

balance_grid        rcb part

species		    ar.species Ar
mixture		    air Ar vstream 0.0 0.0 0.0 temp 273.15

global              nrho 7.07043E22
global              fnum 7.07043E6

collide		    vss air ar.vss

create_particles    air n $n

global              optmove yes
global              particle/reorder ${reorder}
global              collide/every ${cevery}

stats		    10
compute             temp temp
stats_style	    step cpu np nattempt ncoll c_temp

# first equilibrate with large timestep to unsort particles
# then benchmark with normal timestep

timestep 	    7.00E-8
run                 30
timestep 	    7.00E-9
run 		    100
