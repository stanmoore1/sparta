################################################################################
# SPARTA logo, idea 14: collisionless specular box - it reassembles itself
#
# No collide command and every wall specular, so each particle flies ballistic
# and bounces.  In a rectangular box that makes x and y independently periodic,
# with period 2L/|v|.  Give every particle a speed that is an integer multiple
# of 800 m/s and all those periods divide 0.3 s, so at step 3000 every particle
# is back exactly where it started, moving exactly as it was, and the emblem
# reforms on its own.  Verified rather than assumed: the last frame is
# pixel-identical to the first.
#
# The gif therefore loops with no reversal.  It is Poincare recurrence,
# arranged rather than waited for - a real recurrence in a real integrable
# system, not a playback trick.  Adding collisions would destroy it, which is
# what makes the reassembly a statement about the dynamics.
#
# kx and ky are held to -1..1 rather than -2..2 deliberately.  The frame rate
# that reads as motion rather than noise is set by how far the fastest class
# travels between frames: at 25 steps a frame that is 2.8 units here, against
# a 120 unit box.  Doubling the speeds needs double the frames to look like
# anything but static, and the gif cannot afford them.
################################################################################

dimension           2
seed                12345
global              gridcut 0.0 comm/sort yes
boundary            rr rr p

create_box          -600e-1 600e-1 -600e-1 600e-1 -0.5 0.5
create_grid         100 100 1
balance_grid        rcb cell

include             emblem.regions

species             logo.species N O B Nh Oh Nm Om
global              fnum 8.4e16

mixture             g00 N nrho 1.4625e+17 temp 0.0 vstream -800.0 -800.0 0.0
mixture             r00 O nrho 1.4625e+17 temp 0.0 vstream -800.0 -800.0 0.0
mixture             g01 N nrho 1.4625e+17 temp 0.0 vstream -800.0 0.0 0.0
mixture             r01 O nrho 1.4625e+17 temp 0.0 vstream -800.0 0.0 0.0
mixture             g02 N nrho 1.4625e+17 temp 0.0 vstream -800.0 800.0 0.0
mixture             r02 O nrho 1.4625e+17 temp 0.0 vstream -800.0 800.0 0.0
mixture             g03 N nrho 1.4625e+17 temp 0.0 vstream 0.0 -800.0 0.0
mixture             r03 O nrho 1.4625e+17 temp 0.0 vstream 0.0 -800.0 0.0
mixture             g04 N nrho 1.4625e+17 temp 0.0 vstream 0.0 800.0 0.0
mixture             r04 O nrho 1.4625e+17 temp 0.0 vstream 0.0 800.0 0.0
mixture             g05 N nrho 1.4625e+17 temp 0.0 vstream 800.0 -800.0 0.0
mixture             r05 O nrho 1.4625e+17 temp 0.0 vstream 800.0 -800.0 0.0
mixture             g06 N nrho 1.4625e+17 temp 0.0 vstream 800.0 0.0 0.0
mixture             r06 O nrho 1.4625e+17 temp 0.0 vstream 800.0 0.0 0.0
mixture             g07 N nrho 1.4625e+17 temp 0.0 vstream 800.0 800.0 0.0
mixture             r07 O nrho 1.4625e+17 temp 0.0 vstream 800.0 800.0 0.0

create_particles    g00 n 0 region goldletters
create_particles    g00 n 0 region swirlsIn
create_particles    g00 n 0 region outerring
create_particles    g00 n 0 region innerring
create_particles    r00 n 0 region redcenter
create_particles    r00 n 0 region redband
create_particles    g01 n 0 region goldletters
create_particles    g01 n 0 region swirlsIn
create_particles    g01 n 0 region outerring
create_particles    g01 n 0 region innerring
create_particles    r01 n 0 region redcenter
create_particles    r01 n 0 region redband
create_particles    g02 n 0 region goldletters
create_particles    g02 n 0 region swirlsIn
create_particles    g02 n 0 region outerring
create_particles    g02 n 0 region innerring
create_particles    r02 n 0 region redcenter
create_particles    r02 n 0 region redband
create_particles    g03 n 0 region goldletters
create_particles    g03 n 0 region swirlsIn
create_particles    g03 n 0 region outerring
create_particles    g03 n 0 region innerring
create_particles    r03 n 0 region redcenter
create_particles    r03 n 0 region redband
create_particles    g04 n 0 region goldletters
create_particles    g04 n 0 region swirlsIn
create_particles    g04 n 0 region outerring
create_particles    g04 n 0 region innerring
create_particles    r04 n 0 region redcenter
create_particles    r04 n 0 region redband
create_particles    g05 n 0 region goldletters
create_particles    g05 n 0 region swirlsIn
create_particles    g05 n 0 region outerring
create_particles    g05 n 0 region innerring
create_particles    r05 n 0 region redcenter
create_particles    r05 n 0 region redband
create_particles    g06 n 0 region goldletters
create_particles    g06 n 0 region swirlsIn
create_particles    g06 n 0 region outerring
create_particles    g06 n 0 region innerring
create_particles    r06 n 0 region redcenter
create_particles    r06 n 0 region redband
create_particles    g07 n 0 region goldletters
create_particles    g07 n 0 region swirlsIn
create_particles    g07 n 0 region outerring
create_particles    g07 n 0 region innerring
create_particles    r07 n 0 region redcenter
create_particles    r07 n 0 region redband

# no collide: collisions would scramble the phases and the recurrence with them

timestep            0.0001
stats               500
stats_style         step cpu np nbound

dump                3 image all 25 rec.*.ppm type type pdiam 0.9 &
                    box no 1 size 500 500 &
                    view 0 0 center s 0.5 0.5 0.5 zoom 1.98
dump_modify         3 pad 5 backcolor white &
                    color shieldred 0.75 0 0 color shieldgold 0.95 0.75 0.05 &
                    pcolor 1 shieldgold pcolor 2 shieldred

run                 3000
