################################################################################
# SPARTA logo, idea 4: the emblem ablating
#
# The emblem's ring is a solid implicit surface with the swirls cut out of it,
# so it reads as a solid circle carrying the meander pattern.  A hot half-gold
# half-red stream erodes it from the windward edge.
#
# Nothing is inside.  The ring seals its own interior, and particles are only
# created outside it, so the disc stays empty until the flow eats through.
#
# The material is drawn as solid rather than as outlines by colouring the grid
# where there is no gas: cells inside the body hold no particles, so a colour
# map that paints zero density red and everything above it white fills the body
# in and leaves the flow to the particles.
#
# An earlier version made the gold the solid instead.  Those are strands a cell
# or two wide and broke up almost immediately.
#
# This is the application SPARTA exists for, and the emblem is a shield.
#
# emblem.isurf is written by make_isurf.py, which rasterises the same geometry
# the other variants fill with particles onto the grid's corner points.
################################################################################

dimension           2
seed                12345
global              gridcut 0.0 comm/sort yes
boundary            oo rr p

create_box          -600e-1 600e-1 -600e-1 600e-1 -0.5 0.5
create_grid         100 100 1
balance_grid        rcb cell

species             logo.species N O B Nh Oh Nm Om
global              fnum 8.4e16
# half gold, half red: the emblem's palette worn by the flow
mixture             wind N O nrho 1.17e18 temp 300 vstream -2000.0 0.0 0.0
mixture             wind N frac 0.5
mixture             wind O frac 0.5

# surface collisions per cell drive the recession
# zero-density cells are the ones inside the body; the colour map fills them
compute             dens grid all all nrho
fix                 densa ave/grid all 8 5 40 c_dens[1]

compute             isc isurf/grid all all n
fix                 isca ave/grid all 10 10 100 c_isc[*]
fix                 ablate ablate all 100 0.2 f_isca mindist 0.1

global              surfs implicit
read_isurf          all 100 100 1 emblem.isurf 180.5 ablate

surf_collide        hot diffuse 1000.0 1.0
surf_modify         all collide hot

collide             vss all logo.vss
collide_modify      vremax 100 yes

# only outside the ring, so its interior starts and stays empty
region              outside cylinder z 0.0 0.0 570e-1 INF INF side out
create_particles    wind n 0 region outside
fix                 in emit/face wind xhi

timestep            1.0e-4
stats               500
stats_style         step cpu np nscoll

dump                3 image all 40 abl.*.ppm type type pdiam 0.9 &
                    grid f_densa surf one 0.002 box no 1 size 500 500 &
                    view 0 0 center s 0.5 0.5 0.5 zoom 1.98
dump_modify         3 pad 5 backcolor white &
                    color shieldgold 0.95 0.75 0.05 color shieldred 0.75 0 0 &
                    color slate 0.30 0.10 0.10 color clear 1.0 1.0 1.0 &
                    pcolor 1 shieldgold pcolor 2 shieldred scolor * slate &
                    cmap grid 0.0 4.0e17 cf 0.0 2 min shieldred max clear

run                 2400
