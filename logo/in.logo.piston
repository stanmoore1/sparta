################################################################################
# SPARTA logo, idea 2: a piston shock, filmed in the piston's frame
#
# The gas streams left at 2000 m/s into a specular wall at xlo, exactly as the
# original explode does.  It starts at zero temperature, so nothing diffuses:
# the emblem stays pixel-crisp until the shock reaches it, and the only random
# motion in the picture is what the shock itself creates.  The camera is panned left at that same speed, so in
# the image the emblem sits still and the wall drives into it: a flat piston
# hitting the left edge, with the shock it launches running left to right
# through the logo ahead of it.
#
# Filming it this way rather than moving a surface with fix move/surf keeps the
# wall a box boundary, which is both exact and far cheaper.
#
# Note: surf_collide piston is Bird's *subsonic pressure* BC, a wall receding
# from the incident particle, so it is not what drives a compression.
################################################################################

dimension           2
seed                12345
global              gridcut 0.0 comm/sort yes
boundary            so rr p

include             emblem.regions

surf_collide        wall specular
bound_modify        xlo collide wall

species             logo.species N O B Nh Oh
global              fnum 8.4e16

variable            vp equal -2000.0
variable            dt equal 1.0e-4
# camera centre tracks the unshocked material, as a fraction of box width
variable            cx equal (v_vp*step*v_dt+60.0)/120.0

mixture             gold N nrho 1.17e18 temp 0.0 vstream ${vp} 0.0 0.0
mixture             red  O nrho 1.17e18 temp 0.0 vstream ${vp} 0.0 0.0
mixture             bg   B nrho 1.17e18 temp 0.0 vstream ${vp} 0.0 0.0

create_particles    gold n 0 region goldletters
create_particles    gold n 0 region swirlsIn
create_particles    gold n 0 region outerring
create_particles    gold n 0 region innerring
create_particles    red  n 0 region redcenter
create_particles    red  n 0 region redband
create_particles    bg   n 0 region freefield

# the whole field streams left, so feed it from the right to keep frame full
fix                 feed emit/face bg xhi

collide             vss all logo.vss
# undisturbed gas is at rest in its own frame, so vremax there is zero and the
# NTC candidate count stays cheap; re-zero it so cells the shock has left decay
collide_modify      vremax 100 yes

timestep            ${dt}
stats               100
stats_style         step cpu np ncoll

dump                3 image all 4 pis.*.ppm type type pdiam 0.9 &
                    box no 1 size 500 500 &
                    view 0 0 center d v_cx 0.5 0.5 zoom 1.45
dump_modify         3 pad 5 backcolor white &
                    color shieldred 0.75 0 0 color shieldgold 0.95 0.75 0.05 &
                    color gas 0.55 0.68 0.82 &
                    pcolor 1 shieldgold pcolor 2 shieldred pcolor 3 gas &
                    ptrans 3 0.25

run                 160
