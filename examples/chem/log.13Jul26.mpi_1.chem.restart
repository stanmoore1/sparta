# round-trip the full simulation state through a restart file
write_restart       tmp.chem.restart
clear
Running on 1 MPI task(s)
read_restart        tmp.chem.restart
  orthogonal box = (0 0 0) to (0.0001 0.0001 0.0001)
  1000 grid cells
  10760 particles
  CPU time = 0.00242191 secs
  read/surf2grid/rebalance/ghost/inout percent = 94.8008 0.004418 0.0023948 5.18982 0.00251867
seed		    12345

# the collision and reaction models are not stored in the restart file and
# must be re-issued after read_restart so the continued run keeps colliding
collide		    vss air air.vss
react               tce air.tce

# continue the run; particle count and reactions must pick up seamlessly
compute             temp2 temp
stats_style	    step cpu np nattempt ncoll nreact c_temp2
run 		    500
