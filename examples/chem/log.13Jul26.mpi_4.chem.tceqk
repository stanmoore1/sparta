################################################################################
# thermal nitrogen gas in a 3d box, hybrid TCE/QK dissociation chemistry
#
# Regression coverage for the hybrid TCE/QK gas-phase reaction model (react
# tce/qk), which evaluates Arrhenius-flagged reactions with TCE and
# Quantum-flagged reactions with QK from a single reaction file.

#
# Note:
#  - The "comm/sort" option to the "global" command is used to match MPI runs.
#  - The "twopass" option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

seed	    	    12345
dimension   	    3
global              gridcut 1.0e-5 comm/sort yes

boundary	    rr rr rr

create_box  	    0 0.0001 0 0.0001 0 0.0001
Created orthogonal box = (0 0 0) to (0.0001 0.0001 0.0001)
create_grid 	    10 10 10
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (/home/user/sparta/src/grid.cpp:473)
Created 1000 child grid cells
  CPU time = 0.000843541 secs
  create/ghost percent = 94.9318 5.06816
balance_grid        rcb part
Balance grid migrated 740 cells
  CPU time = 0.000616733 secs
  reassign/sort/migrate/ghost percent = 47.0212 0.32283 19.2411 33.4149

species		    air.species N2 N
mixture		    air N2 N vstream 0.0 0.0 0.0 temp 20000.0
mixture             air N2 frac 1.0
mixture             air N frac 0.0

global              nrho 7.07043E22
global              fnum 7.07043E5

collide		    vss air air.vss
react               tce/qk air.tceqk

create_particles    air n 10000 twopass
Created 10000 particles
  CPU time = 0.00115223 secs

# per-grid gas collision and reaction counts, reduced to global scalars

compute             gcol gas/collision/grid all air
compute             grea gas/reaction/grid all air all

compute             rcol reduce sum c_gcol
compute             rrea reduce sum c_grea

stats		    100
compute             temp temp
stats_style	    step cpu np nattempt ncoll nreact c_temp c_rcol c_rrea

timestep 	    7.00E-9
run 		    1000
