SPARTA (27 Aug 2026)
Running on 4 MPI task(s)
################################################################################
# 2d mobile rigid-body circle vs an opposing free-molecular beam
#
# a circular particulate is launched to the right into a cold gas beam
# streaming to the left.  momentum transfer from the colliding particles
# decelerates the body, reverses it, and carries it back downstream.
#
# this is the deck used to render the single-circle rigid-body movie.
# run it as-is for the example; add "-var movie 1" to also dump the
# image frames the movie is encoded from (179 frames):
#   spa_serial -in in.rigid.circle -var movie 1
#   ffmpeg -framerate 20 -pattern_type glob -i 'image.*.ppm' \
#          -vf scale=512:512 -c:v libx264 -pix_fmt yuv420p -b:v 2500k out.mp4
#
# Note:
#  - The "comm/sort" option to the "global" command is used to match MPI runs.
#  - The "twopass" option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    o r p

create_box  	    0 10 0 10 -0.5 0.5
Created orthogonal box = (0 0 -0.5) to (10 10 0.5)
create_grid 	    20 20 1
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (/home/user/sparta/src/grid.cpp:486)
Created 400 child grid cells
  CPU time = 0.0281711 secs
  create/ghost percent = 28.4328 71.5672
balance_grid        rcb cell
Balance grid migrated 280 cells
  CPU time = 0.000585969 secs
  reassign/sort/migrate/ghost percent = 53.3943 0.626996 24.6365 21.3423

global		    nrho 0.5 fnum 0.001

species		    air.species N O
mixture		    air N O vstream -100.0 0 0 temp 1.0

# circle of radius 1 centered at (2.5,5), initially moving in +x

read_surf           data.circle group circle origin 5 5 0                     scale 0.3333333333 0.3333333333 1 trans -2.5 0 0
  50 lines
  1.5 3.5 xlo xhi
  4.00197 5.99803 ylo yhi
  0 0 zlo zhi
  0.125581 min line length
  12 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  384 4 12 = cells outside/inside/overlapping surfs
  12 = surf cells with 1,2,etc splits
  96.8667 96.8667 = cell-wise and global flow volume
  CPU time = 0.000622038 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 8.89383 20.1795 0.528424 58.5329 11.8654 8.69593 0.183751
  surf2grid time = 0.000364097 secs
  map/comm1/comm2/comm3/comm4/split percent = 26.2092 7.56914 7.72459 9.21732 36.5757 6.32743

surf_collide	    1 diffuse 300.0 0.0
surf_modify         all collide 1

# free molecular flow: no gas-gas collisions
# fill the box with the cold leftward beam, emit more at the right face

create_particles    air n 0
Created 48433 particles
  CPU time = 0.00290715 secs
fix		    in emit/face air xhi twopass

timestep 	    0.0001

# per-surf force/torque tallies used to move the rigid body
# moi of a uniform disk of radius R: izz = 1/2 M R^2, ixx = iyy = izz/2

compute             csurf surf circle all fx fy fz tx ty tz com rigid

global              rigid yes

fix		    1 rigid circle csurf single body                     mass 1.8e-24 com 2.5 5 0 vcom 60 0 0                     moi 4.5e-25 4.5e-25 9.0e-25 0 0 0 angmom 0 0 0

variable            movie index 0
if                  "${movie} == 1" then                     "dump 2 image all 25 image.*.ppm type type pdiam 0.06 surf one 0.012 size 800 800 zoom 1.75"                     "dump_modify 2 pad 5 scolor * gray"

stats		    200
stats_style	    step cpu np f_1[1] f_1[4] f_1[15]
run 		    4450
