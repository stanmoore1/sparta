################################################################################
# three mobile rigid-body equilateral triangles in an opposing cold beam
# cells are ~3/4 of a triangle edge: spinning triangles exercise the
# cut/split cell machinery in remap incremental mode
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    o r p

create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    8 8 1
balance_grid        rcb cell

global		    nrho 0.5 fnum 0.001

species		    air.species N O
mixture		    air N O vstream -100.0 0 0 temp 1.0

read_surf           data.tri group bodies trans 3.0 3.0 0
read_surf           data.tri group bodies trans 5.0 6.5 0 typeadd 1
read_surf           data.tri group bodies trans 7.2 3.5 0 typeadd 2

surf_collide	    1 diffuse 300.0 0.0
surf_modify         all collide 1

create_particles    air n 0
fix		    in emit/face air xhi twopass

timestep 	    0.0001


# grid cell flow volumes, for visualizing cut/split cells

compute      vg property/grid all vol

global              rigid yes

# the 3 bodies are numbered by surf type, their params are in the infile
# moi of a uniform triangular plate, edge A: izz = M A^2 / 12

fix	 1 rigid bodies type infile data.tris.bodies &
         push 1.0e-18 0.1 pushstyle hertz pushdamp 1.5e-22 &
         pushbound yes remap incremental

dump                5 image all 25 image.*.ppm type type pdiam 0.04 &
                    surf one 0.014 size 800 800 zoom 1.75 &
                    gline yes 0.004
dump_modify	    5 pad 5 scolor * white glinecolor dimgray

stats		    250
stats_style	    step np f_1[1][1] f_1[1][2] f_1[1][15] &
                    f_1[2][1] f_1[2][2] f_1[2][15] &
                    f_1[3][1] f_1[3][2] f_1[3][15]
run 		    5000
