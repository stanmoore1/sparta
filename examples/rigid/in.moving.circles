################################################################################
# four mobile rigid-body circles in an opposing cold beam
# bodies bounce off each other and the box walls via push-off springs
# while the beam drags them all leftward
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    o r p

create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    20 20 1
balance_grid        rcb cell

global		    nrho 0.5 fnum 0.001

species		    air.species N O
mixture		    air N O vstream -100.0 0 0 temp 1.0

# four circles of radius 0.8

read_surf           data.circle group bodies origin 5 5 0 &
                    scale 0.26666667 0.26666667 1 trans -2.5 -1.8 0
read_surf           data.circle group bodies origin 5 5 0 &
                    scale 0.26666667 0.26666667 1 trans -2.2 1.8 0 typeadd 1
read_surf           data.circle group bodies origin 5 5 0 &
                    scale 0.26666667 0.26666667 1 trans 0.5 0 0 typeadd 2
read_surf           data.circle group bodies origin 5 5 0 &
                    scale 0.26666667 0.26666667 1 trans 2.5 -1.5 0 typeadd 3

surf_collide	    1 diffuse 300.0 0.0
surf_modify         all collide 1

create_particles    air n 0
fix		    in emit/face air xhi twopass

timestep 	    0.0001

compute      c1 surf bodies all fx fy fz tx ty tz com rigid

global              rigid yes

# the 4 bodies are numbered by surf type, their params are in the infile

fix	 1 rigid bodies c1 type infile data.circles.bodies &
         push 1.0e-18 0.1 pushstyle hertz pushdamp 1.5e-22 pushbound yes remap cutcell

dump                5 image all 25 image.*.ppm type type pdiam 0.06 &
                    surf one 0.012 size 800 800 zoom 1.75
dump_modify	    5 pad 5 scolor * gray

stats		    25
stats_style	    step np f_1[1][1] f_1[1][2] f_1[2][1] f_1[2][2] &
                    f_1[3][1] f_1[3][2] f_1[4][1] f_1[4][2]
run 		    5000
