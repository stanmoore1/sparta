################################################################################
# 100 mobile rigid-body circles in a gas at rest
# the bodies start with random velocities and bounce off each other and
# the box walls via push-off springs while the gas slows them down
# the surf file and the body parameter file were made by
#   tools/rigid/replicate.py data.circle24 2 100 data.many.surf \
#     -box 0 10 0 10 -gap 0.5 -seed 12345 \
#     -bodies data.many.bodies 2.0e-24 3.125e-26 3.125e-26 6.25e-26 30.0
# each copy of the circle has its own surf type, which is its body ID
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    r r p

create_box  	    0 10 0 10 -0.5 0.5
