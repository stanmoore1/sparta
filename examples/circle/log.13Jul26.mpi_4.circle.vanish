################################################################################
# 2d flow around a circle whose surface deletes (vanishes) incident particles
#
# Regression coverage for the surf_collide vanish model, which is not used by
# any other example.  Particles that strike the circle are removed from the
# simulation, so the surface acts as a perfect sink.
#
# Note:
#  - The "comm/sort" option to the "global" command is used to match MPI runs.
#  - The "twopass" option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    o r p

create_box  	    0 10 0 10 -0.5 0.5
Created orthogonal box = (0 0 -0.5) to (10 10 0.5)
create_grid 	    20 20 1
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (/home/user/sparta/src/grid.cpp:473)
Created 400 child grid cells
  CPU time = 0.0201006 secs
  create/ghost percent = 39.8311 60.1689
balance_grid        rcb cell
Balance grid migrated 280 cells
  CPU time = 0.00062754 secs
  reassign/sort/migrate/ghost percent = 55.3452 0.515664 19.2904 24.8488

global		    nrho 1.0 fnum 0.001

species		    air.species N O
mixture		    air N O vstream 100.0 0 0

read_surf           data.circle
  50 lines
  2 8 xlo xhi
  2.00592 7.99408 ylo yhi
  0 0 zlo zhi
  0.376743 min line length
  48 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  264 88 48 = cells outside/inside/overlapping surfs
  48 = surf cells with 1,2,etc splits
  71.8 71.8 = cell-wise and global flow volume
  CPU time = 0.000640738 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 11.4496 19.6458 0.8562 57.0063 11.0421 7.29284 0.317759
  surf2grid time = 0.000365261 secs
  map/comm1/comm2/comm3/comm4/split percent = 27.5447 7.74953 5.56041 2.77719 43.1595 7.26439
surf_collide	    1 vanish
surf_modify         all collide 1

collide             vss air air.vss

fix		    in emit/face air xlo twopass

timestep 	    0.0001

compute             bnd boundary air n
stats		    100
stats_style	    step cpu np nscoll c_bnd[2][1]
run 		    1000
