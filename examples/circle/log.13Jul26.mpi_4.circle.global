SPARTA (24 Sep 2025)
Running on 4 MPI task(s)
################################################################################
# 2d flow around a circle whose surface uses the global surf_react model
#
# Regression coverage for the surf_react global style (surf_react_global.cpp),
# which is not used by any other example.  The global model deletes an incident
# particle with probability pdelete and clones it with probability pcreate,
# independent of species.  compute react/surf tallies the reactions.
#
# Note:
#  - The "comm/sort" option to the "global" command is used to match MPI runs.
#  - The "twopass" option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    o r p

create_box  	    0 10 0 10 -0.5 0.5
Created orthogonal box = (0 0 -0.5) to (10 10 0.5)
create_grid 	    20 20 1
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (/home/user/sparta/src/grid.cpp:473)
Created 400 child grid cells
  CPU time = 0.00700869 secs
  create/ghost percent = 98.8522 1.14776
balance_grid        rcb cell
Balance grid migrated 280 cells
  CPU time = 0.00119468 secs
  reassign/sort/migrate/ghost percent = 38.3097 0.239646 26.8119 34.6388

global		    nrho 1.0 fnum 0.001

species		    air.species N O
mixture		    air N O vstream 100.0 0 0

read_surf           data.circle
  50 lines
  2 8 xlo xhi
  2.00592 7.99408 ylo yhi
  0 0 zlo zhi
  0.376743 min line length
  48 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  264 88 48 = cells outside/inside/overlapping surfs
  48 = surf cells with 1,2,etc splits
  71.8 71.8 = cell-wise and global flow volume
  CPU time = 0.0023336 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 5.62441 28.5652 0.189793 62.5237 3.09694 2.80143 0.218461
  surf2grid time = 0.00145905 secs
  map/comm1/comm2/comm3/comm4/split percent = 76.9216 4.1427 3.78335 3.56383 5.9318 3.31558

surf_collide	    1 diffuse 300.0 0.0
# global surf reaction: 30% of collisions delete the particle, 10% clone it
surf_react          1 global 0.3 0.1
surf_modify         all collide 1 react 1

collide             vss air air.vss

fix		    in emit/face air xlo twopass

timestep 	    0.0001

compute             rs react/surf all 1
compute             rrs reduce sum c_rs[*]

stats		    100
stats_style	    step cpu np nscoll nsreact c_rrs[1] c_rrs[2]
run 		    1000
