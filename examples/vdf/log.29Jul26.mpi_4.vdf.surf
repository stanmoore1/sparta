SPARTA (24 Sep 2025)
Running on 4 MPI task(s)
################################################################################
# energy and angular distributions of the flux at a surface
#
# equilibrium Ar gas surrounding a circle whose wall is fully diffuse at 1000 K
#
# the EDF of the reflected flux should reproduce dN/dE ~ E*exp(-E/k/Tsurf),
#   a Gamma distribution with mean 2*k*Tsurf = 2.761e-20 J
# the ADF of both the incident and the reflected flux should follow the
#   cosine law, dN/dtheta ~ sin(theta)*cos(theta), which peaks at 45 degrees
#
# Note:
#  - The "comm/sort" option to the "global" command is used to match MPI runs.
#  - The "twopass" option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    rr rr pp

create_box  	    0 10 0 10 -0.5 0.5
Created orthogonal box = (0 0 -0.5) to (10 10 0.5)
create_grid 	    20 20 1
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (../grid.cpp:473)
Created 400 child grid cells
  CPU time = 0.00106043 secs
  create/ghost percent = 94.2236 5.77644

balance_grid        rcb part
Balance grid migrated 280 cells
  CPU time = 0.000651802 secs
  reassign/sort/migrate/ghost percent = 47.9581 0.215249 14.6856 37.141

read_surf           data.circle
  50 lines
  2 8 xlo xhi
  2.00592 7.99408 ylo yhi
  0 0 zlo zhi
  0.376743 min line length
  48 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  264 88 48 = cells outside/inside/overlapping surfs
  48 = surf cells with 1,2,etc splits
  71.8 71.8 = cell-wise and global flow volume
  CPU time = 0.000797478 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 17.4817 22.0657 1.22398 45.4653 13.7633 11.6593 0.53293
  surf2grid time = 0.000362576 secs
  map/comm1/comm2/comm3/comm4/split percent = 28.8577 10.2856 6.01005 5.86194 24.4316 14.028

species		    ar.species Ar
mixture		    air Ar vstream 0.0 0.0 0.0 temp 300.0

global              nrho 1.0e20
global              fnum 1.0e18

collide		    vss air ar.vss

surf_collide	    1 diffuse 1000.0 1.0
surf_modify         all collide 1

create_particles    air n 0 twopass
Created 7180 particles
  CPU time = 0.00140196 secs

# 20 energy bins from 0 to 1e-19 J, 18 angle bins spanning 0 to 90 degrees

compute             edf edf/surf all air 20 0.0 1.0e-19 dir reflected
compute             adfi adf/surf all air 18 dir incident
compute             adfr adf/surf all air 18 dir reflected

fix                 fe ave/surf all 1 100 100 c_edf[*] ave running
fix                 fai ave/surf all 1 100 100 c_adfi[*] ave running
fix                 far ave/surf all 1 100 100 c_adfr[*] ave running

# sum each histogram bin over all surface elements, so the log file records
#   the distributions

compute             se reduce sum f_fe[*]
compute             sai reduce sum f_fai[*]
compute             sar reduce sum f_far[*]

stats		    100
stats_style	    step cpu np nscoll c_se[3] c_se[6] c_se[12]                     c_sai[5] c_sai[9] c_sai[14] c_sar[5] c_sar[9] c_sar[14]

dump                1 surf all 1000 tmp.vdf.surf id f_fe[*] f_fai[*] f_far[*]

timestep 	    1.0e-4
run 		    1000
