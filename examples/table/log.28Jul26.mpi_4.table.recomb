SPARTA (24 Sep 2025)
Running on 4 MPI task(s)
################################################################################
# tabulated three-body recombination in a 3d box
#
# O + O + M --> O2 + M, with the recombination cross section read from a
# file.  Because the reaction is three-body, react table multiplies the
# tabulated cross section by the number density of the third particle
# SPARTA selects from the same grid cell, so the tabulated quantity is a
# cross section per unit density with units of m^5.
#
# The cross section is constant here so the initial rate is analytic.  With
# n_O = 1e22 /m^3, T = 10000 K, sigma_rec = 5e-43 m^5 and a mean relative
# speed <g> = sqrt(8kT/pi mr) = 5147 m/s, the recombination rate is
#
#   1/2 n_O^2 n_M sigma_rec <g> * V/fnum * dt = 2.57 reactions per step
#
# or 2.83 per step after the small correction for the fluctuation in the
# number of particles per grid cell, against 2.63 measured over the first
# 200 steps.  Thereafter the rate falls off as n_O^2 as O is consumed,
# each recombination destroys a particle so Np drops, and the 8.197e-19 J
# released per reaction heats the gas.
#
# Note:
#  - The "comm/sort” option to the “global” command is used to match MPI runs.
#  - The “twopass” option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

seed	    	    12345
dimension   	    3
global              gridcut 0.0 comm/sort yes

boundary	    p p p

create_box  	    0 0.0001 0 0.0001 0 0.0001
Created orthogonal box = (0 0 0) to (0.0001 0.0001 0.0001)
create_grid 	    10 10 10
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (../grid.cpp:473)
Created 1000 child grid cells
  CPU time = 0.00173082 secs
  create/ghost percent = 87.2112 12.7888

balance_grid        rcb cell
Balance grid migrated 740 cells
  CPU time = 0.000865322 secs
  reassign/sort/migrate/ghost percent = 36.8785 0.406207 29.0661 33.6492

species		    recomb.species O O2
mixture		    gas O O2 vstream 0.0 0.0 0.0 temp 10000.0
mixture             gas O frac 1.0
mixture             gas O2 frac 0.0

global              nrho 1.0E22
global              fnum 5.0E5

collide		    vss gas recomb.vss
react               table recomb.reactions

# SPARTA selects a third particle only 1/rboost of the time and scales the
# probability up by rboost, which leaves the rate unchanged as long as the
# boosted probability stays below 1.  The default of 1000 is chosen for the
# Arrhenius styles; with this tabulated cross section it would push the
# probability well past 1 and clip the rate, so turn the boost off.

react_modify        rboost 1.0

create_particles    gas n 20000 twopass
Created 20000 particles
  CPU time = 0.00224071 secs

stats		    200
compute             temp temp
compute             c count O O2
stats_style	    step cpu np nattempt ncoll nreact c_temp c_c[1] c_c[2]

timestep 	    1.0E-9
run 		    2000
