Running on 1 MPI task(s)
################################################################################
# 2d flow around a circle, GS surface adsorption/reaction model
#
# Coverage variant of in.circle.gs: uses sample-GS_cov.surf, which adds the
# optional Kisliuk sticking model, the CI "energy" rate option, and the
# specular/adiabatic/none per-reaction surf collide models.
#
# Note:
#  - The "comm/sort" option to the "global" command is used to match MPI runs.
#  - The "twopass" option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    	o r p

create_box  	    0 10 0 10 -0.5 0.5
Created orthogonal box = (0 0 -0.5) to (10 10 0.5)
create_grid 	    20 20 1
Created 400 child grid cells
  CPU time = 0.00116801 secs
  create/ghost percent = 89.3856 10.6144
balance_grid        rcb cell
Balance grid migrated 0 cells
  CPU time = 0.000262976 secs
  reassign/sort/migrate/ghost percent = 14.8685 0.725295 7.25295 77.1532

global		    	nrho 1.0 fnum 0.001

species		    	air.species O CO CO2 O2 C
mixture		    	air O O2 C vstream 100.0 0 0

mixture             air O   frac 0.7
mixture             air CO  frac 0.0
mixture             air CO2 frac 0.0
mixture             air O2  frac 0.2
mixture             air C   frac 0.1

read_surf           data.circle
  50 lines
  2 8 xlo xhi
  2.00592 7.99408 ylo yhi
  0 0 zlo zhi
  0.376743 min line length
  48 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  264 88 48 = cells outside/inside/overlapping surfs
  48 = surf cells with 1,2,etc splits
  71.8 71.8 = cell-wise and global flow volume
  CPU time = 0.000732899 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 10.0846 17.339 2.04945 62.8822 7.64476 5.04229 0.130124
  surf2grid time = 0.000460863 secs
  map/comm1/comm2/comm3/comm4/split percent = 43.611 6.51837 16.5028 4.34558 18.417 8.01862

surf_collide        1 cll 300.0 0.5 0.5 0.5 0.5

################################### SURF REACT ADSORB ######################################

surf_react          adsorb_test_gs_cov adsorb gs sample-GS_cov.surf nsync 1 surf 1000 6.022e9 O CO
surf_modify         all collide 1 react adsorb_test_gs_cov

############################################################################################

fix		    		in emit/face air xlo nevery 100 n 10000 perspecies no twopass

timestep 	    	0.0001

stats		    	10
stats_style	    	step cpu np nattempt ncoll nscoll nscheck
run 		    	500
