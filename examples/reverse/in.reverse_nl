# Frozen reservoir for the nonlinear-rotor (rotdof=3) reverse-reaction check
# (validate_reverse.py).  Exchange pair TRIA + ATB <-> DIA + ATO where TRIA is
# a nonlinear triatomic (rotdof=3), exercising the nonlinear rotational
# partition function (qrot ~ T^1.5) and the zcont=3/2 continuum in the
# detailed-balance table.  Variables: T, NRHO, FNUM.

seed            12345
dimension       3
global          gridcut 1.0e-5 comm/sort yes
boundary        rr rr rr

create_box      0 0.0001 0 0.0001 0 0.0001
create_grid     2 2 2
balance_grid    rcb part

species         nl.species TRIA DIA ATO ATB rotfile nl.rot elecfile nl.elec
mixture         gas TRIA DIA ATO ATB vstream 0.0 0.0 0.0 temp ${T}
mixture         gas TRIA frac 0.25
mixture         gas DIA  frac 0.25
mixture         gas ATO  frac 0.25
mixture         gas ATB  frac 0.25

global          nrho ${NRHO}
global          fnum ${FNUM}

collide         vss gas nl.vss relax constant
collide_modify  rotate discrete vibrate discrete electronic discrete
fix             electronic elecmode
collide_modify  remain no

react           tce nl.tce
react_modify    partial_energy no compute_chem_rates yes rboost 1000.0

create_particles gas n 40000 twopass

compute         temp temp
stats           2000
stats_style     step np c_temp

timestep        1.00E-9
run             12000
