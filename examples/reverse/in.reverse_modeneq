# Mode-resolved non-equilibrium frozen reservoir (validate_reverse.py checks
# 23-24).  Like in.reverse_noneq but the rotational, vibrational, and
# electronic temperatures are set INDEPENDENTLY (${TROT}, ${TVIB}, ${TELEC})
# on top of the translational temperature ${T}, so a single internal mode can
# be driven out of equilibrium while the others stay at the translational
# temperature.  The validator supplies air_frozen.species/air_frozen.elec
# (relaxation numbers zeroed) so the multi-temperature state is stationary and
# the reverse rate reflects a fixed, mode-specific non-Boltzmann collision-
# energy distribution.  Variables: T, TROT, TVIB, TELEC, NRHO, FNUM.

seed            12345
dimension       3
global          gridcut 1.0e-5 comm/sort yes
boundary        rr rr rr

create_box      0 0.0001 0 0.0001 0 0.0001
create_grid     2 2 2
balance_grid    rcb part

species         air_frozen.species N2 O NO N rotfile air.rot elecfile air_frozen.elec
mixture         air N2 O NO N vstream 0.0 0.0 0.0 temp ${T} &
                trot ${TROT} tvib ${TVIB} telec ${TELEC}
mixture         air N2 frac 0.25
mixture         air O  frac 0.25
mixture         air NO frac 0.25
mixture         air N  frac 0.25

global          nrho ${NRHO}
global          fnum ${FNUM}

collide         vss air air.vss relax constant
collide_modify  rotate discrete vibrate discrete electronic discrete
fix             electronic elecmode
collide_modify  remain no

react           tce rev_noneq.tce
react_modify    partial_energy no compute_chem_rates yes rboost 1000.0

create_particles air n 40000 twopass

compute         temp temp
stats           4000
stats_style     step np c_temp

timestep        1.00E-9
run             30000
