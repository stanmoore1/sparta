# Frozen reservoir for the charge-exchange reverse-reaction check
# (validate_reverse.py).  Charge-exchange MAp + MB <-> MA + MBp moves charge
# between two atoms with no free electron, so it is an EXCHANGE reaction (unlike
# ionization, whose reverse depends on the electron temperature); its reverse
# rate is derived by detailed balance.  Variables: T, NRHO, FNUM.

seed            12345
dimension       3
global          gridcut 1.0e-5 comm/sort yes
boundary        rr rr rr

create_box      0 0.0001 0 0.0001 0 0.0001
create_grid     2 2 2
balance_grid    rcb part

species         ce.species MA MAp MB MBp elecfile ce.elec
mixture         gas MA MAp MB MBp vstream 0.0 0.0 0.0 temp ${T}
mixture         gas MA  frac 0.25
mixture         gas MAp frac 0.25
mixture         gas MB  frac 0.25
mixture         gas MBp frac 0.25

global          nrho ${NRHO}
global          fnum ${FNUM}

collide         vss gas ce.vss relax constant
collide_modify  electronic discrete
fix             electronic elecmode
collide_modify  remain no

react           tce ce.tce
react_modify    partial_energy no compute_chem_rates yes rboost 1000.0

create_particles gas n 40000 twopass

compute         temp temp
stats           4000
stats_style     step np c_temp

timestep        1.00E-9
run             20000
