# Frozen five-species reservoir for the MULTI-CHANNEL detailed-balance check
# (validate_reverse.py).  Two coupled Zeldovich exchange reactions
# (N2+O<->NO+N and NO+O<->O2+N) share species NO/O/N; both reverses are
# generated by "reverse auto" and must each satisfy detailed balance
# simultaneously while competing for the shared reactants.  Reactions are
# tallied but not performed (compute_chem_rates yes) so the composition and
# temperature stay fixed.  Variables: T, NRHO, FNUM.

seed            12345
dimension       3
global          gridcut 1.0e-5 comm/sort yes
boundary        rr rr rr

create_box      0 0.0001 0 0.0001 0 0.0001
create_grid     2 2 2
balance_grid    rcb part

species         air.species O2 N2 O N NO rotfile air.rot elecfile air.elec
mixture         air O2 N2 O N NO vstream 0.0 0.0 0.0 temp ${T}
mixture         air O2 frac 0.2
mixture         air N2 frac 0.2
mixture         air O  frac 0.2
mixture         air N  frac 0.2
mixture         air NO frac 0.2

global          nrho ${NRHO}
global          fnum ${FNUM}

collide         vss air air.vss relax constant
collide_modify  rotate discrete vibrate discrete electronic discrete
fix             electronic elecmode
collide_modify  remain no

react           tce multi_fwd.tce
react_modify    partial_energy no compute_chem_rates yes rboost 1000.0 reverse auto

create_particles air n 40000 twopass

compute         temp temp
stats           4000
stats_style     step np c_temp

timestep        1.00E-9
run             20000
