# Two-temperature frozen reservoir for the non-equilibrium reverse-rate check
# (validate_reverse.py check 14).  The translational temperature is ${T}; the
# rotational, vibrational, and electronic modes are initialized at ${TINT} and
# held frozen there.  Freezing is supplied by the validator, which writes
# air_frozen.species and air_frozen.elec with every relaxation number zeroed
# (relax constant then applies zero relaxation probability), so with reactions
# tallied but not performed (compute_chem_rates yes) the two-temperature state
# is stationary and the measured reverse rate reflects a fixed non-Boltzmann
# collision-energy distribution.  Variables: T, TINT, NRHO, FNUM.

seed            12345
dimension       3
global          gridcut 1.0e-5 comm/sort yes
boundary        rr rr rr

create_box      0 0.0001 0 0.0001 0 0.0001
create_grid     2 2 2
balance_grid    rcb part

species         air_frozen.species N2 O NO N rotfile air.rot elecfile air_frozen.elec
mixture         air N2 O NO N vstream 0.0 0.0 0.0 temp ${T} &
                trot ${TINT} tvib ${TINT} telec ${TINT}
mixture         air N2 frac 0.25
mixture         air O  frac 0.25
mixture         air NO frac 0.25
mixture         air N  frac 0.25

global          nrho ${NRHO}
global          fnum ${FNUM}

collide         vss air air.vss relax constant
collide_modify  rotate discrete vibrate discrete electronic discrete
fix             electronic elecmode
collide_modify  remain no

react           tce rev_noneq.tce
react_modify    partial_energy no compute_chem_rates yes rboost 1000.0

create_particles air n 40000 twopass

compute         temp temp
stats           4000
stats_style     step np c_temp

timestep        1.00E-9
run             8000
