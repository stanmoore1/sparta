################################################################################
# 2d flow past an implicit circle with surface chemistry; exercises
# compute react/isurf/grid
#
# Regression coverage for compute react/isurf/grid (compute_react_isurf_grid.cpp)
# which tallies surface reactions on implicit surface elements per grid cell.
# No other example uses it.  The explicit circle is converted to an implicit
# surface with create_isurf, given a surf_react prob model, and the per-grid
# reaction tallies are reduced to a scalar for the regression comparison.
#
# Note:
#  - The "comm/sort" option to the "global" command is used to match MPI runs.
#  - The "twopass" option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

seed			12345
dimension		2
boundary		p p p
global                  gridcut 1.E-1 comm/sort yes

create_box		-1.0 1.0 -1.0 1.0 -0.5 0.5
Created orthogonal box = (-1 -1 -0.5) to (1 1 0.5)
create_grid		80 80 1
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (/home/user/sparta/src/grid.cpp:473)
Created 6400 child grid cells
  CPU time = 0.00112022 secs
  create/ghost percent = 88.4367 11.5633
balance_grid		rcb cell
Balance grid migrated 4800 cells
  CPU time = 0.00203986 secs
  reassign/sort/migrate/ghost percent = 25.9023 0.729608 24.403 48.9651

global			nrho 1.0 fnum 0.001
global                  surfs explicit/distributed

species			air.species N2
mixture			air N2 vstream 100.0 0 0 temp 300.0

read_surf               data.circle2d invert
  100 lines
  -0.75 0.75 xlo xhi
  -0.75 0.75 ylo yhi
  0 0 zlo zhi
  0.0471161 min line length
  243 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  3465 2692 243 = cells outside/inside/overlapping surfs
  243 = surf cells with 1,2,etc splits
  2.23402 2.23402 = cell-wise and global flow volume
  CPU time = 0.00192197 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 9.62621 6.50192 2.18161 48.3363 33.354 8.64081 2.01371
  surf2grid time = 0.00092901 secs
  map/comm1/comm2/comm3/comm4/split percent = 34.7586 4.58736 18.4848 3.94312 19.2029 8.2646
surf_collide		1 diffuse 300.0 0.0
fix		        fablate ablate all 0 0.2 random 0
create_isurf            all fablate 39.5 ave
  6400 0 0 = cells outside/inside/overlapping surfs
  0 = surf cells with 1,2,etc splits
  4 4 = cell-wise and global flow volume
  -0.75 0.75 xlo xhi
  -0.75 0.75 ylo yhi
  0 0 zlo zhi
  0.00153672 min line length
  236 = cells with surfs
  236 = total surfs in all grid cells
  1 = max surfs in one grid cell
  0.0614686 = min surf-size/cell-size ratio
  236 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  3472 2692 236 = cells outside/inside/overlapping surfs
  236 = surf cells with 1,2,etc splits
  2.23415 2.23415 = cell-wise and global flow volume

# surface reaction model on the implicit surface
surf_react              1 prob isurf.react
surf_modify		all collide 1 react 1

create_particles        air n 10000 twopass
Created 10000 particles
  CPU time = 0.00129382 secs
collide			vss air air.vss

# per-grid tally of implicit-surface reactions, reduced to a scalar
compute                 ris react/isurf/grid all 1
compute                 rr reduce sum c_ris[*]

timestep		0.0001
stats			50
stats_style		step cpu np nscoll nsreact c_rr
run			500
