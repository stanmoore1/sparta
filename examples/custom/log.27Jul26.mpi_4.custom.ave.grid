variable            v1 grid c_cid
variable            v2 grid c_cid*10
variable            v3 grid c_cid+0.25
variable            v4 grid c_cid*10+0.5

custom              grid create givec int 0 set givec v_v1 all NULL
Custom grid attributes set = 0
custom              grid create gdvec float 0 set gdvec v_v3 all NULL
Custom grid attributes set = 0

custom              grid create giarray int 2 set giarray[1] v_v1 all NULL
Custom grid attributes set = 0
custom              grid set giarray[2] v_v2 all NULL
Custom grid attributes set = 0

custom              grid create gdarray float 2 set gdarray[1] v_v3 all NULL
Custom grid attributes set = 0
custom              grid set gdarray[2] v_v4 all NULL
Custom grid attributes set = 0

# time-average the custom vectors and array columns
# this is the command that used to be rejected

fix                 avg ave/grid all 10 5 50                     g_givec g_gdvec g_giarray[1] g_giarray[2]                     g_gdarray[1] g_gdarray[2]

fix		    in emit/face air xlo twopass

timestep 	    0.0001

compute             direct reduce ave g_givec g_gdvec                     g_giarray[*] g_gdarray[*]
compute             ave reduce ave f_avg[1] f_avg[2] f_avg[3] f_avg[4]                     f_avg[5] f_avg[6]

stats		    50
stats_style	    step cpu np c_direct[*] c_ave[*]

run 		    200
