variable            gi1 grid c_cid
variable            gi2 grid c_cid*10
variable            gi3 grid c_cid*100
variable            gd1 grid c_cid+0.25
variable            gd2 grid c_cid*10+0.5
variable            gd3 grid c_cid*100+0.75

custom              grid create giarray int 3 set giarray[1] v_gi1 all NULL
Custom grid attributes set = 0
custom              grid set giarray[2] v_gi2 all NULL
Custom grid attributes set = 0
custom              grid set giarray[3] v_gi3 all NULL
Custom grid attributes set = 0

custom              grid create gdarray float 3 set gdarray[1] v_gd1 all NULL
Custom grid attributes set = 0
custom              grid set gdarray[2] v_gd2 all NULL
Custom grid attributes set = 0
custom              grid set gdarray[3] v_gd3 all NULL
Custom grid attributes set = 0

# read every column back through a grid-style variable

variable            rgi1 grid g_giarray[1]
variable            rgi2 grid g_giarray[2]
variable            rgi3 grid g_giarray[3]
variable            rgd1 grid g_gdarray[1]
variable            rgd2 grid g_gdarray[2]
variable            rgd3 grid g_gdarray[3]

compute             gdirect reduce ave g_giarray[*] g_gdarray[*]
compute             gvar reduce ave v_rgi1 v_rgi2 v_rgi3 v_rgd1 v_rgd2 v_rgd3

# ---------------------------------------------------------------------------
# per-surf custom array, same pattern
# ---------------------------------------------------------------------------

compute             sid property/surf all id

run                 0
