# remove the two int attributes
# ncustom stays 4, so slots 0 and 1 are now tombstones with stale ewhich

stats_style	    step cpu np
uncompute           all4

custom              grid remove givec
Custom grid attributes set = 0
custom              grid remove giarray
Custom grid attributes set = 0

# force grow_cells(), which calls reallocate_custom() with the tombstones present

adapt_grid          all refine random 1.0 0.0
Adapting grid ...
  100 cells refined, 0 cells coarsened
  adapted to 400 grid cells
  CPU time = 0.000234128 secs
  adapt/redo percent = 72.1507 27.8493

# re-set the surviving float attributes on the new grid, then check them
# against the same variables they were assigned from

custom              grid set gdvec v_v3 all NULL
Custom grid attributes set = 0
custom              grid set gdarray[1] v_v3 all NULL
Custom grid attributes set = 0
custom              grid set gdarray[2] v_v4 all NULL
Custom grid attributes set = 0

# add a new int vector, which reuses the storage slot that reallocate_custom
# had grown on behalf of the removed givec tombstone

custom              grid create gnew int 0 set gnew v_v1 all NULL
Custom grid attributes set = 0

compute             direct reduce ave g_gdvec g_gdarray[1] g_gdarray[2] g_gnew
compute             expect reduce ave v_v3 v_v3 v_v4 v_v1

stats_style	    step cpu np c_direct[*] c_expect[*]

run 		    100
