+
+/* ----------------------------------------------------------------------
+   sum per-surf tallies of implicit surfs into owned grid cells
+   shared by compute isurf/grid and compute react/isurf/grid (+ kk styles)
+   nrow tallies, ncol values each, ids = surf IDs = IDs of the owning cells
+   out = per-grid array for nlocal owned cells, zeroed here
+   usual case: every tallied cell is still an owned or ghost cell of this
+     proc, use Grid::collate_array_implicit() directly
+   if the grid changed since the tallies were made (e.g. fix balance
+     migrated cells on the tally step), a tallied cell may be neither owned
+     nor ghost anymore, Grid::collate_array_implicit() cannot route it
+     (it would sum it into owned cell 0), so route those tallies to the
+     cell's current owner via a rendezvous directory of owned cell IDs
+   tallies for cells that no longer exist anywhere (e.g. refined away)
+     are dropped
+------------------------------------------------------------------------- */
+
+namespace {
+  struct RvousTally {
+    Memory *memory;
+    int ncol;
+  };
+
+  union ubufc {
+    double d;
+    int64_t i;
+    ubufc(double arg) : d(arg) {}
+    ubufc(int64_t arg) : i(arg) {}
+  };
+
+  inline int rvous_proc(cellint id, int nprocs)
+  {
+    uint64_t h = (uint64_t) id;
+    h ^= h >> 33;
+    h *= 0xff51afd7ed558ccdULL;
+    h ^= h >> 33;
+    return (int) (h % (uint64_t) nprocs);
+  }
+
+  // input datum = ID, owner proc (-1 for a tally), ncol values
+  // output datum = ID, ncol values, sent to the owner proc
+
+  int rvous_route(int n, char *inbuf, int &flag, int *&proclist,
+                  char *&outbuf, void *ptr)
+  {
+    RvousTally *rt = (RvousTally *) ptr;
+    int ncol = rt->ncol;
+    int insize = ncol + 2;
+    double *in = (double *) inbuf;
+
+    std::map<cellint,int> owner;
+    int ntally = 0;
+    for (int i = 0; i < n; i++) {
+      double *one = &in[(bigint) i*insize];
+      int proc = (int) ubufc(one[1]).i;
+      if (proc >= 0) owner[(cellint) ubufc(one[0]).i] = proc;
+      else ntally++;
+    }
+
+    rt->memory->create(proclist,ntally,"isurf/grid:proclist");
+    double *out = (double *)
+      rt->memory->smalloc((bigint) ntally*(ncol+1)*sizeof(double),
+                          "isurf/grid:outbuf");
+
+    int nout = 0;
+    bigint m = 0;
+    for (int i = 0; i < n; i++) {
+      double *one = &in[(bigint) i*insize];
+      if ((int) ubufc(one[1]).i >= 0) continue;
+      std::map<cellint,int>::iterator it =
+        owner.find((cellint) ubufc(one[0]).i);
+      if (it == owner.end()) continue;
+      proclist[nout++] = it->second;
+      out[m++] = one[0];
+      for (int j = 0; j < ncol; j++) out[m++] = one[2+j];
+    }
+
+    flag = 2;
+    outbuf = (char *) out;
+    return nout;
+  }
+}
+
+void ComputeISurfGrid::collate_tallies(SPARTA *sparta, int nrow, int ncol,
+                                       surfint *ids, double **in,
+                                       double **out)
+{
+  Grid *grid = sparta->grid;
+  Comm *comm = sparta->comm;
+  Memory *memory = sparta->memory;
+
+  if (!grid->hashfilled) grid->rehash();
+  Grid::MyHash *ghash = grid->hash;
+
+  // nunknown = # of my tallies whose cell I neither own nor ghost
+
+  int nunknown = 0;
+  for (int i = 0; i < nrow; i++)
+    if (ghash->find((cellint) ids[i]) == ghash->end()) nunknown++;
+
+  int anyunknown;
+  MPI_Allreduce(&nunknown,&anyunknown,1,MPI_INT,MPI_MAX,sparta->world);
+
+  if (!anyunknown) {
+    grid->collate_array_implicit(nrow,ncol,(cellint *) ids,in,out);
+    return;
+  }
+
+  // split tallies into known (normal collate) and unknown (rendezvous)
+
+  int nknown = nrow - nunknown;
+  cellint *kids;
+  double **kin;
+  memory->create(kids,MAX(nknown,1),"isurf/grid:kids");
+  kin = (double **) memory->smalloc((bigint) MAX(nknown,1)*sizeof(double *),
+                                    "isurf/grid:kin");
+
+  Grid::ChildCell *cells = grid->cells;
+  int nglocal = grid->nlocal;
+  int nprocs = comm->nprocs;
+  int me = comm->me;
+
+  // rendezvous input: directory of my owned cells + my unknown tallies
+
+  int ndir = 0;
+  for (int icell = 0; icell < nglocal; icell++)
+    if (cells[icell].nsplit > 0) ndir++;
+
+  int nsend = ndir + nunknown;
+  int insize = ncol + 2;
+  int *proclist;
+  double *inbuf;
+  memory->create(proclist,MAX(nsend,1),"isurf/grid:proclist");
+  memory->create(inbuf,(bigint) MAX(nsend,1)*insize,"isurf/grid:inbuf");
+
+  int n = 0;
+  bigint m = 0;
+  for (int icell = 0; icell < nglocal; icell++) {
+    if (cells[icell].nsplit <= 0) continue;
+    proclist[n++] = rvous_proc(cells[icell].id,nprocs);
+    inbuf[m++] = ubufc((int64_t) cells[icell].id).d;
+    inbuf[m++] = ubufc((int64_t) me).d;
+    for (int j = 0; j < ncol; j++) inbuf[m++] = 0.0;
+  }
+
+  nknown = 0;
+  for (int i = 0; i < nrow; i++) {
+    if (ghash->find((cellint) ids[i]) != ghash->end()) {
+      kids[nknown] = (cellint) ids[i];
+      kin[nknown++] = in[i];
+      continue;
+    }
+    proclist[n++] = rvous_proc((cellint) ids[i],nprocs);
+    inbuf[m++] = ubufc((int64_t) ids[i]).d;
+    inbuf[m++] = ubufc((int64_t) -1).d;
+    for (int j = 0; j < ncol; j++) inbuf[m++] = in[i][j];
+  }
+
+  // normal collate of known tallies, zeroes out
+
+  grid->collate_array_implicit(nknown,ncol,kids,kin,out);
+
+  memory->destroy(kids);
+  memory->sfree(kin);
+
+  // route unknown tallies to current owners of their cells
+
+  RvousTally rt;
+  rt.memory = memory;
+  rt.ncol = ncol;
+
+  char *buf;
+  int nout = comm->rendezvous(1,nsend,(char *) inbuf,insize*sizeof(double),
+                              0,proclist,rvous_route,
+                              0,buf,(ncol+1)*sizeof(double),(void *) &rt);
+  double *outbuf = (double *) buf;
+
+  memory->destroy(proclist);
+  memory->destroy(inbuf);
+
+  // sum routed tallies into my owned cells
+
+  if (!grid->hashfilled) grid->rehash();
+  ghash = grid->hash;
+
+  m = 0;
+  for (int i = 0; i < nout; i++) {
+    cellint cellID = (cellint) ubufc(outbuf[m++]).i;
+    Grid::MyHash::iterator it = ghash->find(cellID);
+    if (it == ghash->end() || it->second >= nglocal) {
+      m += ncol;
+      continue;
+    }
+    int icell = it->second;
+    for (int j = 0; j < ncol; j++) out[icell][j] += outbuf[m++];
+  }
+
+  memory->sfree(outbuf);
+}
