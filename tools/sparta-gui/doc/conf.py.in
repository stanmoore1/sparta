import sys
import os
import importlib.util
from datetime import date

has_enchant = False
try:
    import enchant
    has_enchant = True
except:
    pass

# -- Project information -----------------------------------------------------
# https://www.sphinx-doc.org/en/master/usage/configuration.html#project-information

def get_git_info():
    import subprocess

    git_n_date = ''
    try:
        gitinfo = subprocess.run(['git','describe'],stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        if gitinfo.returncode == 0:
            git_n_date = gitinfo.stdout.decode().replace('_',' ').replace('patch ','').replace('stable ','')
    except:
        pass
    return git_n_date.strip()

project = 'SPARTA-GUI'
author = 'The SPARTA and LAMMPS-GUI developers'
copyright = '2023 - {}, {}'.format(date.today().year, author)
version = '@PROJECT_VERSION@'
release = get_git_info()
language = 'en'

rst_prolog = ".. |copyright| replace:: {0}".format(copyright)

# -- General configuration ---------------------------------------------------
# https://www.sphinx-doc.org/en/master/usage/configuration.html#general-configuration

needs_sphinx = '6.0.0'

extensions = []

exclude_patterns = ['_build']
suppress_warnings = []

# The API reference is extracted from the C++ sources with Doxygen and
# imported through the "breathe" extension.  Both are optional: when the
# breathe module or the Doxygen XML output is not available (e.g. for a
# plain "sphinx-build" run outside of the CMake "html" target), the API
# reference page is skipped instead of failing the build.
breathe_xml_dir = '@CMAKE_CURRENT_BINARY_DIR@/doxygen/xml'
if importlib.util.find_spec("breathe") and os.path.isdir(breathe_xml_dir):
    extensions.append('breathe')
    breathe_projects = {
        "SPARTA-GUI": breathe_xml_dir
    }
    breathe_default_project = "SPARTA-GUI"
    breathe_default_members = ('members', 'undoc-members')
else:
    exclude_patterns.append('api_reference.rst')
    # index.rst lists the page in its toctree unconditionally, which is right
    # for the full build; without it the reference is dangling by construction,
    # so the warning says nothing a reader of this build can act on.
    suppress_warnings.append('toc.excluded')

# optional extensions used for the full documentation build; a plain
# sphinx-build still works when they are not installed
if importlib.util.find_spec("sphinxcontrib.jquery"):
    extensions.append('sphinxcontrib.jquery')
if importlib.util.find_spec("sphinx_sitemap"):
    extensions.append('sphinx_sitemap')

images_config = {
        'default_image_width' : '25%',
        'default_group' : 'default',
        }

# Add any paths that contain templates here, relative to this directory.
templates_path = ['_templates']

# The suffix of source filenames.
#source_suffix = {'.rst': 'restructuredtext'}

# The name of an image file (within the static path) to use as favicon of the
html_favicon = '_static/sparta-gui.ico'

# the main document
master_doc = 'index'

# The encoding of source files.
#source_encoding = 'utf-8-sig'

#nitpicky = True

# -- Options for HTML output -------------------------------------------------
# https://www.sphinx-doc.org/en/master/usage/configuration.html#options-for-html-output

html_title = 'SPARTA-GUI Documentation'
html_short_title = 'SPARTA-GUI'
# under _images/, where the file actually is; without the directory Sphinx
# resolves it against the config directory, finds nothing, and every page
# is built with no logo at all
html_logo = '_images/sparta-gui-banner.png'
html_theme = 'sphinxdoc'
html_theme_options = {
        "body_min_width": 700,
        "body_max_width": 1200,
}
html_static_path = ['_static']
html_baseurl = 'https://sparta.github.io/sparta-gui/'
html_last_updated_fmt = '%b %d, %Y'
html_show_sourcelink = False
html_permalinks = True

html_use_index = True
html_copy_source = False
html_domain_indices = False

# add SPARTA input file lexer for Pygments
conf_script_dir = os.path.dirname(os.path.realpath(__file__))
sys.path.append(os.path.join(conf_script_dir, '.'))
import SPARTALexer
from sphinx.highlighting import lexers

lexers['SPARTA'] = SPARTALexer.SPARTALexer(startinline=True)

# avoid syntax highlighting in blocks that don't specify language
highlight_language = 'none'

# configure sitemap generation
sitemap_url_scheme = "{link}"
sitemap_filename = "sitemap.xml"

# configure spelling extensions, if present
spelling_spec = importlib.util.find_spec("sphinxcontrib.spelling")
if spelling_spec and has_enchant:
    extensions.append('sphinxcontrib.spelling')
    spelling_lang = 'en_US'
    spelling_word_list_filename='false_positives.txt'

# configure latex output
latex_engine = 'pdflatex'
latex_theme = 'howto'
latex_logo = '_images/sparta-gui-banner.png'
latex_elements = {
    'preamble': format("""
    \\usepackage[columns=1]{idxlayout}
    \\newcommand{\\spartaversion}{Release v%s}
    """ % version),
    'maketitle': r'''
% customized titlepage
{%
  \hypersetup{pageanchor=false}% avoid duplicate destination warnings
  \begin{titlepage}%
    \sffamily\bfseries
    \begingroup % for PDF information dictionary
      \def\endgraf{ }\def\and{\& }%
      \pdfstringdefDisableCommands{\def\\{, }}% overwrite hyperref setup
      \hypersetup{pdfauthor={The SPARTA and LAMMPS-GUI developers}, pdftitle={SPARTA-GUI Documentation}}%
    \endgroup
    \noindent\rule{\textwidth}{4pt}\par
    \begin{center}%
      \sphinxlogo
      \vfill
      {\Huge SPARTA-GUI Documentation \par}
      \vfill
      {\LARGE \spartaversion \par}
      \vfill
      {\LARGE The SPARTA and LAMMPS-GUI developers \par}
      \vfill\vfill\vfill
    \end{center}
    \noindent\rule{\textwidth}{4pt}\par
  \end{titlepage}%
  \setcounter{footnote}{0}%
  \clearpage
}
''',
}
