# TEST: restart continuation, reference run
# a body is driven into a static wall by push-off springs, with no
# particles, so the trajectory is deterministic.  in.test.restart.part1
# and .part2 split the same run in two across a write_restart/read_restart
# and must reproduce this run's final state.
# run as: -var nrun <steps>
seed	    	    12345
variable            nrun index 1500
dimension   	    2
boundary            r r p
create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    20 20 1
global		    nrho 1.0 fnum 0.001
species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0
read_surf           data.square group bodies
read_surf           data.wall group wall
read_surf           data.square group bodies trans 0 3 0 typeadd 1
surf_collide	    1 specular
surf_modify         all collide 1
timestep 	    0.0001
global              rigid yes
fix		    1 rigid bodies type infile data.restart.bodies &
                    push 1.0e-18 0.5 pushbound yes
stats		    ${nrun}
stats_style         step f_1[1][1] f_1[1][4] f_1[1][15] &
                    f_1[2][1] f_1[2][4] f_1[2][15]
stats_modify        format float %.17g
run 		    ${nrun}
