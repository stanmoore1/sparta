# TEST: bodies crossing processor boundaries with distributed surfs
# three gas-driven bodies with push-off contacts between them and with
# the box boundaries, fast enough to cross the whole box, so on several
# procs each body sweeps through the sub-domains of several procs
# with distributed surfs a proc only stores local copies of the bodies
# which can reach its cells, appended as a body approaches, and the
# trajectories must be identical to a run with non-distributed surfs
# on the same procs, where every proc stores every body
# run as: -var dist 0   (or 1)

seed	    	    12345

variable            dist index 0
variable            bodies index replicated
if "${dist} == 1" then "global surfs explicit/distributed"
dimension   	    2
global              gridcut 1.0 comm/sort yes

boundary            r r p

create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    20 20 1
balance_grid        rcb cell

global		    nrho 1.0 fnum 0.001

species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0

read_surf           data.square group bodies trans -3.5 -3.0 0
read_surf           data.square group bodies trans -0.5 -2.0 0 typeadd 1
read_surf           data.square group bodies trans -3.0 2.5 0 typeadd 2
surf_collide	    1 specular
surf_modify         all collide 1

timestep 	    0.0001


global              rigid yes

fix		    1 rigid bodies type infile data.crossproc.bodies &
                    push 1.0e-18 0.3 pushbound yes &
                    bodies ${bodies}

create_particles    air n 20000

stats		    100
stats_style         step np f_1[1][1] f_1[1][2] f_1[1][4] f_1[1][15] &
                    f_1[2][1] f_1[2][2] f_1[2][4] f_1[2][15] &
                    f_1[3][1] f_1[3][2] f_1[3][4] f_1[3][15]
stats_modify        format float %20.14e
run 		    600
