# TEST: push-off contact between TWO bodies of revolution on the same axis
#
# no particles.  a cylinder slides along the axis into a second, stationary
# cylinder and they exchange momentum through the contact spring.  the
# contact force is ring-weighted by 2*pi*r, and the equal-and-opposite
# reaction on the second body uses the SAME weighted force, so the total
# axial momentum of the pair is conserved exactly however the weighting is
# chosen.  both bodies must stay on the axis
#
# this is the body-body branch of push_contact in an axisymmetric domain,
# which the single-body axipush deck does not reach

seed	    	    12345

variable            dist index 0
if "${dist} == 1" then "global surfs explicit/distributed"
dimension   	    2
boundary            o ar p

create_box  	    0 2 0 0.3 -0.5 0.5
create_grid 	    40 6 1
balance_grid        rcb cell

global		    nrho 1.0 fnum 0.001

species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0

read_surf           adata.cylinder group b1 trans 0.2 0 0
read_surf           adata.cylinder group b2 trans 0.55 0 0
surf_collide	    1 specular
surf_modify         all collide 1

timestep 	    1.0e-6

compute             c1 surf b1 all fx fy fz tx ty tz com 0.7 0 0
compute             c2 surf b2 all fx fy fz tx ty tz com 1.05 0 0

global              rigid yes

fix		    1 rigid b1 c1 body &
		    mass 1.0e-22 com 0.7 0 0 vcom 100.0 0 0 &
		    moi 5.0e-25 1.0e-24 1.0e-24 0 0 0 angmom 0 0 0 &
                    push 5.0e-15 0.03
fix		    2 rigid b2 c2 body &
		    mass 2.0e-22 com 1.05 0 0 vcom 0 0 0 &
		    moi 1.0e-24 2.0e-24 2.0e-24 0 0 0 angmom 0 0 0 &
                    push 5.0e-15 0.03

stats		    250
stats_style         step f_1[1] f_1[4] f_1[5] f_2[1] f_2[4] f_2[5] &
                    f_1[21] f_2[21]
stats_modify        format float %20.14e
run 		    3000
