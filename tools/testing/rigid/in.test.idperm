# TEST: the physics must not depend on how the bodies are numbered
# three squares colliding via push-off, no particles, run twice: with
# body IDs (1,2,3) and with the same bodies numbered (3,1,2), which
# changes the order of the body element table and of every per-body
# loop; each body must follow the same trajectory in both runs
# run as: -var ta 2 -var tb 0 -var tc 1 -var bodies data.idperm.312.bodies

seed	    	    12345

variable            ta index 0
variable            tb index 1
variable            tc index 2
variable            bodies index data.idperm.123.bodies
dimension   	    2
boundary            r r p

create_box  	    0 20 0 20 -0.5 0.5
create_grid 	    20 20 1

global		    nrho 1.0 fnum 0.001

species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0

read_surf           data.square group bodies trans 0.0 5.0 0 typeadd ${ta}
read_surf           data.square group bodies trans 4.5 5.2 0 typeadd ${tb}
read_surf           data.square group bodies trans 8.0 5.6 0 typeadd ${tc}
surf_collide	    1 specular
surf_modify         all collide 1

timestep 	    0.0001

compute             c1 surf bodies all fx fy fz tx ty tz com rigid

global              rigid yes

fix		    1 rigid bodies c1 type infile ${bodies} push 1.0e-17 0.3

stats		    200
stats_style         step f_1[1][1] f_1[1][2] f_1[1][4] f_1[1][5] f_1[1][15] &
                    f_1[2][1] f_1[2][2] f_1[2][4] f_1[2][5] f_1[2][15] &
                    f_1[3][1] f_1[3][2] f_1[3][4] f_1[3][5] f_1[3][15]
stats_modify        format float %20.14e
run 		    2000
