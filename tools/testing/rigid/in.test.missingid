# NEGATIVE TEST: a body ID with no surfs
# two squares with surf types 1 and 3: body 2 has no surface elements,
# and fix rigid must say so rather than silently define an empty body

seed	    	    12345
dimension   	    2
boundary            r r p

create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    10 10 1

global		    nrho 1.0 fnum 0.001

species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0

read_surf           data.square group bodies trans -2 0 0
read_surf           data.square group bodies trans 2 0 0 typeadd 2
surf_collide	    1 specular
surf_modify         all collide 1

timestep 	    0.0001


global              rigid yes

fix		    1 rigid bodies type infile data.twobody.bodies

run 		    10
