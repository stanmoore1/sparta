# Deposition with no room left: grow the film until the box is mostly solid
#
# in.test.conserve puts the corner point grid on a sub-block of the flow grid,
# the way examples/ablation/in.ablation.2d does, so there is gas around the
# body.  Corner point values only exist on that block, so the surface stops
# when it reaches the block's edge and fix ablate says so.
#
# Here the corner point grid IS the whole box, so nothing stops the film until
# it runs out of box.  Two things this covers that in.test.conserve cannot:
#
#  - a surface is allowed to end on the simulation box, and the group boundary
#    check has to know that, or it would refuse a perfectly legal case
#  - the deposition rate can be pushed far higher.  At RATE = 1.0 the film
#    reaches about 78% of the maximum possible corner point value, buries
#    around 12% of the gas, and reflects over 200000 particles back into the
#    flow, all with fix grid/check running with the error setting
#
# The conservation identity is the same one in.test.conserve asserts:
#
#   np(0) - np(t)  ==  nburied
#
# Above roughly RATE = 2 the half-cell-per-regeneration guard takes over, and
# near RATE = 0.7 there is a marching squares degeneracy that the mindist
# keyword cures; neither is specific to deposition.

variable            RATE index 1.0
variable            NEVERY index 1
variable            SEED index 12345

# the x boundary, overridden to p by the test that asserts a film may
# grow to a reflecting box face but not to a periodic one
variable            BOUNDX index r

seed                ${SEED}
dimension           2
global              gridcut 0.0 comm/sort yes

boundary            ${BOUNDX} r p

create_box          0 100 0 100 -0.5 0.5
create_grid         100 100 1

# implicit surfaces need a clumped grid partition to acquire ghost cells
balance_grid        rcb cell

global              nrho 1.0 fnum 0.01

species             air.species N
mixture             air N

fix                 ablate ablate all ${NEVERY} ${RATE} uniform 1 mode deposit

global              surfs implicit
read_isurf          all 100 100 1 ../../../examples/ablation/binary.101x101 &
                    180.5 ablate

surf_collide        1 diffuse 300.0 1.0
surf_modify         all collide 1

timestep            0.0001

create_particles    air n 200000

fix                 check grid/check 1 error

stats               50
stats_style         step np f_ablate f_ablate[3] f_ablate[4] f_ablate[8] f_ablate[20]

run                 200
