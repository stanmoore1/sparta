# Deposition fast-growth guard test
#
# The csurfs collision lists are rebuilt only when the isosurface is
# regenerated, so a front which travels more than half a grid cell between
# regenerations would reach particles that are never tested against it.
# fix ablate must refuse to run in that case rather than silently overtake
# them.  run_tests.py expects this input to abort with an error naming the
# front advance.

seed                12345
dimension           2
global              gridcut 0.0 comm/sort yes

boundary            r r p

create_box          0 150 0 150 -0.5 0.5
create_grid         150 150 1

global              nrho 1.0 fnum 0.01

species             air.species N
mixture             air N

region              inner block 25.5 124.5 25.5 124.5 INF INF
group               inner grid region inner one

# 5 corner value units per regeneration is far too fast

fix                 ablate ablate inner 1 1.0 uniform 5 mode deposit

global              surfs implicit
read_isurf          inner 100 100 1 ../../../examples/ablation/binary.101x101 180.5 ablate

surf_collide        1 diffuse 300.0 1.0
surf_modify         all collide 1

timestep            0.0001

create_particles    air n 10000

stats               1
stats_style         step np

run                 5
