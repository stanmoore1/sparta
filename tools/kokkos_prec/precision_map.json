{
  "_comment": "Single source of truth for the KOKKOS precision conversion scripts. See README.",
  "structs": {
    "OnePart": {
      "header": "src/particle.h",
      "scope": "Particle",
      "kk_name": "OnePartKK",
      "fields": {
        "x": "pos",
        "v": "float",
        "erot": "float",
        "evib": "float",
        "dtremain": "pos",
        "weight": "float"
      }
    },
    "ChildCell": {
      "header": "src/grid.h",
      "scope": "Grid",
      "kk_name": "ChildCellKK",
      "fields": {
        "lo": "pos",
        "hi": "pos"
      }
    },
    "SplitInfo": {
      "header": "src/grid.h",
      "scope": "Grid",
      "kk_name": "SplitInfoKK",
      "fields": {
        "xsplit": "pos"
      }
    },
    "ParentCell": {
      "header": "src/grid.h",
      "scope": "Grid",
      "kk_name": "ParentCellKK",
      "fields": {
        "lo": "pos",
        "hi": "pos"
      }
    },
    "Line": {
      "header": "src/surf.h",
      "scope": "Surf",
      "kk_name": "LineKK",
      "fields": {
        "p1": "pos",
        "p2": "pos",
        "norm": "pos"
      }
    },
    "Tri": {
      "header": "src/surf.h",
      "scope": "Surf",
      "kk_name": "TriKK",
      "fields": {
        "p1": "pos",
        "p2": "pos",
        "p3": "pos",
        "norm": "pos"
      }
    }
  },
  "precision_classes": {
    "float": "KK_FLOAT",
    "pos": "KK_POS_FLOAT",
    "acc": "KK_ACC_FLOAT",
    "double": "double"
  },
  "modes": {
    "SPARTA_KOKKOS_DOUBLE_DOUBLE": {
      "float": "double",
      "pos": "double",
      "acc": "double"
    },
    "SPARTA_KOKKOS_SINGLE_DOUBLE": {
      "float": "float",
      "pos": "double",
      "acc": "double"
    },
    "SPARTA_KOKKOS_SINGLE_SINGLE": {
      "float": "float",
      "pos": "float",
      "acc": "float"
    }
  },
  "conversion": {
    "_comment": "Used by kk_prec_convert.py. Identifier lists choose the precision class of a 'double' declaration in device code by the declared name; anything else becomes KK_FLOAT.",
    "skip_files": [
      "kokkos_type.h",
      "kokkos_structs.h",
      "math_extra_kokkos.h",
      "rand_pool_wrap.h",
      "rand_pool_wrap.cpp",
      "kissfft_kokkos.h",
      "fftdata_kokkos.h",
      "fft2d_kokkos.h",
      "fft2d_kokkos.cpp",
      "fft3d_kokkos.h",
      "fft3d_kokkos.cpp",
      "remap2d_kokkos.h",
      "remap2d_kokkos.cpp",
      "remap3d_kokkos.h",
      "remap3d_kokkos.cpp",
      "pack2d_kokkos.h",
      "pack3d_kokkos.h",
      "kokkos_base_fft.h"
    ],
    "type_renames": [
      [
        "\\b(t|tdual)_float_1d_strided",
        "\\1_kkacc_1d_strided"
      ],
      [
        "\\btdual_float_2d_lr",
        "ttransform_kkacc_2d_lr"
      ],
      [
        "\\bt_float_2d_lr",
        "t_kkacc_2d_lr"
      ],
      [
        "\\btdual_float_(1d_3|2d(?!_lr)|3d|scalar|1d(?!_3|_strided))",
        "ttransform_kkfloat_\\1"
      ],
      [
        "\\bt_float_(1d_3|2d(?!_lr)|3d|scalar|1d(?!_3|_strided))",
        "t_kkfloat_\\1"
      ],
      [
        "\\bSPARTA_FLOAT\\b",
        "KK_FLOAT"
      ],
      [
        "\\bF_FLOAT\\b",
        "KK_ACC_FLOAT"
      ]
    ],
    "struct_renames": [
      [
        "\\bParticle::OnePart\\b",
        "OnePartKK"
      ],
      [
        "(?<![:\\w])OnePart\\b(?!KK|Restart)",
        "OnePartKK"
      ],
      [
        "\\bGrid::ChildCell\\b",
        "ChildCellKK"
      ],
      [
        "\\bGrid::SplitInfo\\b",
        "SplitInfoKK"
      ],
      [
        "\\bGrid::ParentCell\\b",
        "ParentCellKK"
      ],
      [
        "\\bSurf::Line\\b",
        "LineKK"
      ],
      [
        "\\bSurf::Tri\\b",
        "TriKK"
      ]
    ],
