seed               12345
dimension          3
global             gridcut 1.0e-5 comm/sort yes
boundary           p p p
create_box         0.1 0.1001 0 0.0001 0 0.0001
create_grid        10 10 10
species            ar.species Ar
mixture            air Ar vstream 300.0 0.0 0.0 temp 273.15
global             nrho 7.07043E22
global             fnum 7.07043E6
create_particles   air n 20000 twopass
dump               1 particle all 5 dump.conv.* id type x y z vx vy vz
dump_modify        1 format float %.17g
timestep           7.00E-9
run                5
