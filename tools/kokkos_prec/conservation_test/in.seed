# the input script seed must reach the KOKKOS random pools: particles are
#   created first, then the seed is reset to ${cseed} before the styles that
#   draw random numbers on the device (collisions, inflow) are defined
seed                12345
dimension           3
boundary            o p p
create_box          0 0.0001 0 0.0001 0 0.0001
create_grid         10 10 10
species             air.species N2 N
mixture             air N2 N vstream 2000.0 0.0 0.0 temp 5000.0
mixture             air N2 frac 0.7
mixture             air N frac 0.3
global              nrho 7.07043E22
global              fnum 1.5E6
create_particles    air n 0 twopass

seed                ${cseed}
collide             vss air air.vss
fix                 in emit/face air xlo

stats_style         step np nattempt ncoll
stats               50
timestep            7.00E-9
run                 200
